<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="project1_env">
    <!-- Required GZ Sim Plugins -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    
    <!-- Light & Ground -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Assignment Environment Walls -->
    <model name="project1_walls">
      <static>true</static>
      
      <!-- ROOM: 15ft (4.57m) x 10ft (3.05m) -->
      <!-- North Wall -->
      <link name="room_north">
        <pose>0 1.525 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>4.57 0.1 1.0</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>4.57 0.1 1.0</size></box></geometry></collision>
      </link>
      <!-- West Wall -->
      <link name="room_west">
        <pose>-2.285 0 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.1 3.05 1.0</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.1 3.05 1.0</size></box></geometry></collision>
      </link>
      <!-- East Wall -->
      <link name="room_east">
        <pose>2.285 0 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.1 3.05 1.0</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.1 3.05 1.0</size></box></geometry></collision>
      </link>

      <!-- South Wall with 5ft (1.52m) Middle Doorway -->
      <link name="room_south_left">
        <pose>-1.525 -1.525 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>1.52 0.1 1.0</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>1.52 0.1 1.0</size></box></geometry></collision>
      </link>
      <link name="room_south_right">
        <pose>1.525 -1.525 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>1.52 0.1 1.0</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>1.52 0.1 1.0</size></box></geometry></collision>
      </link>

      <!-- HALLWAY: 5ft (1.52m) wide, backwards L-shape -->
      <!-- Hallway Outer South Wall (15ft / 4.57m long branch) -->
      <link name="hall_outer_south">
        <pose>0 -3.045 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>4.57 0.1 1.0</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>4.57 0.1 1.0</size></box></geometry></collision>
      </link>
      
      <!-- Hallway Outer East Wall (20ft / 6.10m long branch) -->
      <!-- Adjusted to include a 5ft doorway 5ft from the end -->
      <link name="hall_outer_east_top">
        <pose>3.805 0.76 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.1 1.52 1.0</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.1 1.52 1.0</size></box></geometry></collision>
      </link>
      <link name="hall_outer_east_bottom">
        <pose>3.805 -2.28 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.1 3.05 1.0</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.1 3.05 1.0</size></box></geometry></collision>
      </link>
      
      <!-- Hallway Caps (Closing the ends) -->
      <link name="hall_cap_southwest">
        <pose>-2.285 -2.285 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>0.1 1.52 1.0</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>0.1 1.52 1.0</size></box></geometry></collision>
      </link>
      <link name="hall_cap_northeast">
        <pose>3.045 1.525 0.5 0 0 0</pose>
        <visual name="v"><geometry><box><size>1.52 0.1 1.0</size></box></geometry><material><ambient>0.2 0.5 0.8 1</ambient></material></visual>
        <collision name="c"><geometry><box><size>1.52 0.1 1.0</size></box></geometry></collision>
      </link>
    </model>
  </world>
</sdf>
